{
  "name": "@rihla/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed API client generated from apps/api/openapi.json (used by the portal and the Studio).",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "pnpm --filter @rihla/api openapi && openapi-typescript ../../apps/api/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
