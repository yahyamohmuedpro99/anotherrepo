{
  "name": "@rihla/pack-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rihla experience pack format: types, JSON Schema, validator and the rihla-pack CLI.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./json-schema/*": "./dist/json-schema/*",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "bin": {
    "rihla-pack": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/emit-json-schema.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.13"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}