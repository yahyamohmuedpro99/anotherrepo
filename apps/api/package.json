{
  "name": "@rihla/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rihla REST API: tenants, auth, classes, assignments, learning events, reports, packs, publishers, compliance.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jobs": "./src/jobs/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "openapi": "tsx src/emit-openapi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.15",
    "@fastify/cookie": "11.0.1",
    "@fastify/swagger": "9.4.0",
    "@fastify/type-provider-typebox": "5.1.0",
    "@rihla/pack-schema": "workspace:*",
    "@sinclair/typebox": "0.34.13",
    "drizzle-orm": "0.38.3",
    "fastify": "5.2.0",
    "jose": "5.9.6",
    "pg": "8.13.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
