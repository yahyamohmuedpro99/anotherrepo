# Player: tiny shell, hashed assets cached forever; packs, API and rooms proxied.
# Rendered by the nginx image's envsubst at start: API_UPSTREAM, ROOMS_UPSTREAM (http://api:4000 in Compose,
# https://… on hosts without a private network) and NGINX_RESOLVER (from /etc/resolv.conf, see 15-resolver.envsh).
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types application/javascript application/json text/css image/svg+xml application/manifest+json;
  gzip_min_length 1024;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options nosniff always;
  }

  # Resolve upstreams per request so nginx starts before api/rooms are up.
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
  set $api_upstream ${API_UPSTREAM};
  set $rooms_upstream ${ROOMS_UPSTREAM};
  proxy_ssl_server_name on;

  # built packs come from the API (it rebuilds them on hosts without a persistent disk, ADR-0021)
  location /packs/ {
    proxy_pass $api_upstream;
    proxy_set_header X-Forwarded-Host $host;
  }

  location = /sw.js { add_header Cache-Control "no-cache" always; }

  # API (events, code resolution, class join) and the printed short links
  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 2m;
  }
  location /s/ {
    proxy_pass $api_upstream;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # live class sessions (Colyseus: HTTP matchmaking + WebSocket)
  location /rooms/ {
    rewrite ^/rooms/(.*)$ /$1 break;
    proxy_pass $rooms_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
  }

  location / {
    try_files $uri /index.html;
  }
}
