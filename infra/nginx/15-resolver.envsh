#!/bin/sh
# Sourced by the nginx image's entrypoint before templates render: use the container's own DNS server
# (127.0.0.11 under Docker Compose, the platform's resolver elsewhere) unless NGINX_RESOLVER is set.
if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf)
  case "$NGINX_RESOLVER" in *:*) NGINX_RESOLVER="[$NGINX_RESOLVER]" ;; esac
  export NGINX_RESOLVER
fi
