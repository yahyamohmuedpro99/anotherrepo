# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# 32+ random bytes each, e.g. `openssl rand -hex 32`
JWT_SECRET=
ROOM_TOKEN_SECRET=
INTERNAL_SECRET=
PLAYER_URL=http://localhost:8080
PORTAL_URL=http://localhost:3000
SHORT_URL=http://localhost:8080/s
ROOMS_PUBLIC_URL=ws://localhost:8080/rooms
COOKIE_SECURE=0
# OIDC for adults stays off until client ids exist (ADR-0007)
OIDC_GOOGLE_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_ID=
